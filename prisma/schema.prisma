generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  PLAYER
}

enum GameStatus {
  DRAFT
  LOBBY
  IN_PROGRESS
  COMPLETED
}

enum QuestionStatus {
  HIDDEN
  OPEN
  CLOSED
  REVEALED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  passwordHash    String?
  role            Role             @default(PLAYER)
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  createdGames    Game[]           @relation("GameCreator")
  captainedTeams  Team[]           @relation("TeamCaptain")
  teamMemberships TeamMembership[]
  guesses         Guess[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Game {
  id          String           @id @default(cuid())
  title       String
  joinCode    String           @unique
  status      GameStatus       @default(DRAFT)
  createdById String
  createdBy   User             @relation("GameCreator", fields: [createdById], references: [id], onDelete: Restrict)
  questions   Question[]
  teams       Team[]
  memberships TeamMembership[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([createdById])
  @@index([status])
}

model Team {
  id          String           @id @default(cuid())
  gameId      String
  captainId   String?
  name        String
  game        Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  captain     User?            @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: Restrict)
  memberships TeamMembership[]
  guesses     Guess[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([gameId, name])
  @@index([gameId])
  @@index([captainId])
}

model TeamMembership {
  id        String   @id @default(cuid())
  gameId    String
  teamId    String
  userId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([gameId, userId])
  @@unique([teamId, userId])
  @@index([gameId])
  @@index([teamId])
  @@index([userId])
}

model Question {
  id            String         @id @default(cuid())
  gameId        String
  prompt        String
  correctAnswer Float
  explanation   String?
  order         Int
  status        QuestionStatus @default(HIDDEN)
  game          Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  guesses       Guess[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([gameId, order])
  @@index([gameId])
}

model Guess {
  id         String   @id @default(cuid())
  questionId String
  teamId     String
  userId     String
  value      Float
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([questionId, teamId])
  @@index([questionId])
  @@index([teamId])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
